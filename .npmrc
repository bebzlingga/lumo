# npm's strict peer resolution rejects this tree; the tree is correct anyway.
#
# `react-native-iap@15.3.6` declares `react-native-nitro-modules@^0.35.0` as a
# peer, while `@kingstinct/react-native-healthkit@14.0.2` wants `>=0.35` and the
# app is on 0.36.5. npm 7+ treats that as fatal, so `npm ci` fails on EAS Build
# even though the same tree installs and compiles here.
#
# It is the METADATA that is stale, not the pairing: `ios/Podfile.lock` pins
# `NitroIap (15.3.6)` built against `NitroModules (0.36.5)`, which is the
# combination the committed native project was generated from and the one that
# ships. Loosening the check keeps CI installing exactly what this machine has.
#
# Revisit when react-native-iap is upgraded — 16.x lists `^0.36.5` as its peer,
# so this line can go at that point. Upgrading is a major bump that also
# invalidates `Podfile.lock`, which is why it is not being done mid-release.
legacy-peer-deps=true
