# EAS upload exclusions. When this file exists EAS uses it INSTEAD of
# .gitignore, so everything .gitignore covers must be repeated here.

# --- mirrors .gitignore ---
.expo/
.expo-shared/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
dist/
web-build/
.env
.env.local

# --- not needed to build the app ---
# Standalone React web prototype; never enters the Metro graph.
habit-journey/
# CocoaPods are resolved on the build worker from Podfile.lock.
ios/Pods/
ios/build/
# Edge functions and SQL deploy to Supabase, not into the binary.
supabase/
# Design docs and tests.
DESIGN.md
**/__tests__/
jest.config.js
