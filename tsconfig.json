{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions",
    // Standalone Vite web prototype with its own toolchain, its own
    // node_modules, and a `@/App` import that collides with `app/` on
    // case-insensitive filesystems. It is already kept out of builds by
    // .easignore; including it here made `npm run typecheck` permanently
    // red (48 errors, none of them the app's) and therefore useless.
    "habit-journey"
  ]
}