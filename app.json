{
  "expo": {
    "name": "Lumo",
    "slug": "lumo",
    "scheme": "lumo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/lumo-logo.png",
    "splash": {
      "image": "./assets/lumo-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lumo.habits",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "Lumo uses speech recognition to turn your voice into text.",
        "NSMicrophoneUsageDescription": "Lumo needs the microphone to dictate your journal."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.lumo.habits"
        ]
      }
    },
    "android": {
      "package": "com.lumo.habits",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-asset",
      "@bacons/apple-targets",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lumo needs photo access to attach images to your journal."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Lumo needs the microphone to dictate your journal.",
          "speechRecognitionPermission": "Lumo uses speech recognition to turn your voice into text."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.lumo.habits.widget",
                  "targetName": "LumoWidget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.lumo.habits"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "ed18109c-8f2f-4b29-870c-a660a65b5068"
      }
    },
    "owner": "bebzlingga"
  }
}
