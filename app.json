{
  "expo": {
    "name": "Lumo",
    "slug": "lumo",
    "scheme": "lumo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lumo.habits",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.lumo.habits"]
      }
    },
    "android": {
      "package": "com.lumo.habits"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-asset",
      "@bacons/apple-targets",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lumo needs photo access to attach images to your journal."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Lumo needs the microphone to dictate your journal.",
          "speechRecognitionPermission": "Lumo uses speech recognition to turn your voice into text."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
