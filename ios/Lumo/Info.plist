<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Lumo</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.1.0</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleURLTypes</key>
    <array>
      <dict>
        <key>CFBundleURLSchemes</key>
        <array>
          <string>lumo</string>
          <string>com.lumo.habits</string>
        </array>
      </dict>
      <dict>
        <key>CFBundleURLSchemes</key>
        <array>
          <string>exp+lumo</string>
        </array>
      </dict>
    </array>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>LSMinimumSystemVersion</key>
    <string>12.0</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSAppTransportSecurity</key>
    <dict>
      <key>NSAllowsArbitraryLoads</key>
      <false/>
      <key>NSAllowsLocalNetworking</key>
      <true/>
    </dict>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Lumo uses your location to trace the route of a walk and measure how far you went.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Lumo keeps recording your walk while the screen is off, so your route and distance stay accurate when the phone is in your pocket.</string>
    <key>NSMotionUsageDescription</key>
    <string>Lumo reads your step count so a walk can show how many steps it took.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Lumo needs the microphone to dictate your journal.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Lumo needs photo access to attach images to your journal, and to put one of your photos behind a walk when you share it.</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Lumo uses speech recognition to turn your voice into text.</string>
    <key>NSUserActivityTypes</key>
    <array>
      <string>$(PRODUCT_BUNDLE_IDENTIFIER).expo.index_route</string>
    </array>
    <!-- Both modes are reviewed by Apple, so both must stay true.

         `audio` is Focus: it plays an ambient loop while you work, and working
         means the screen is off and the phone is face down. Without this the
         sound stops the moment the app backgrounds, which is precisely when it
         is meant to be doing its job.

         `location` is Walk: a walk is recorded with the phone in a pocket and
         the screen off, so without it the route stops when the screen locks —
         which is most of the session.

         If either feature ever stops doing that in the background, its mode
         comes out with it.

         Mirrored in app.json for parity. The plist is what actually ships —
         app.json's infoPlist block is only read during prebuild, which this
         repo never runs. -->
    <!-- Lumo Move reads steps, distance and Apple exercise time so walks and
         runs count toward Move goals and badges automatically. It reads ONLY
         those three types and never writes to Health — `movementProvider.ts`
         asks for `{ read: HK_READ }` and passes no share types at all.

         NSHealthUpdateUsageDescription is here anyway, and that is not a
         contradiction. The OS only prompts with it when an app requests write
         authorisation, but App Store Connect's upload validator scans the
         LINKED BINARY: the HealthKit library ships write APIs whether or not
         they are called, so a build without this key is rejected at submission
         with "Missing purpose string in Info.plist". Removing it fails the
         upload, not the build — which is why this comment exists.

         Mirrored in app.json for parity. The plist is what actually ships —
         app.json's infoPlist block is only read during prebuild, which this
         repo never runs. -->
    <key>NSHealthShareUsageDescription</key>
    <string>Lumo reads your steps, walking and running distance, and active minutes so your movement counts toward your Move goals, badges and challenges automatically.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>Lumo never adds anything to Health — it only reads your steps, distance and active minutes. This appears because the Health framework Lumo uses is able to write, not because Lumo does.</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>location</string>
    </array>
    <key>UILaunchStoryboardName</key>
    <string>SplashScreen</string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
      <string>arm64</string>
    </array>
    <key>UIRequiresFullScreen</key>
    <false/>
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleDefault</string>
    <!-- Landscape is allowed at the OS level ONLY so Focus mode can rotate into
         it. Every other screen pins itself back to portrait at runtime via
         expo-screen-orientation, so the app is still portrait everywhere the
         user has not explicitly asked otherwise. Removing landscape here would
         make the rotate a no-op on iPhone. -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
      <string>UIInterfaceOrientationPortrait</string>
      <string>UIInterfaceOrientationPortraitUpsideDown</string>
      <string>UIInterfaceOrientationLandscapeLeft</string>
      <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
      <string>UIInterfaceOrientationPortrait</string>
      <string>UIInterfaceOrientationPortraitUpsideDown</string>
      <string>UIInterfaceOrientationLandscapeLeft</string>
      <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIUserInterfaceStyle</key>
    <string>Automatic</string>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
  </dict>
</plist>